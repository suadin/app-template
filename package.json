{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "start": "python3 -m http.server 4173 --directory site",
    "test": "node --test --experimental-test-coverage --test-coverage-include='site/logic.js' --test-coverage-include='site/reader.js' --test-coverage-include='site/version.js' test/*.test.js",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "metrics": "node scripts/metrics.mjs",
    "check:docs": "node check-docs.mjs",
    "basics": "python3 basics/check.py --root .",
    "check": "pnpm basics check --run && pnpm metrics && pnpm check:docs",
    "publish-site": "./publish.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
